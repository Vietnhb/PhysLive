{
  "id": "oscillations_waves",
  "title": "Dao động, sóng và truyền thông tin bằng sóng vô tuyến (Vật lí 11)",
  "source": "Chương trình GDPT môn Vật lí 2018, mục V.2, lớp 11: Dao động; Sóng; Chuyên đề 11.2",
  "contents": [
    {
      "name": "Dao động – Dao động điều hoà",
      "level": "quantitative",
      "requirement": "Vận dụng được các khái niệm biên độ, chu kì, tần số, tần số góc, độ lệch pha; vận dụng được các phương trình về li độ, vận tốc, gia tốc; vận dụng được a = −ω²x; mô tả được sự chuyển hoá động năng và thế năng."
    },
    {
      "name": "Dao động – Dao động tắt dần, hiện tượng cộng hưởng",
      "level": "qualitative",
      "requirement": "Nêu được ví dụ về dao động tắt dần, dao động cưỡng bức và cộng hưởng; đánh giá được sự có lợi hay có hại của cộng hưởng. (Chỉ kiểm được chiều: cơ năng không tăng khi chỉ có lực cản.)"
    },
    {
      "name": "Sóng – Mô tả sóng",
      "level": "quantitative",
      "requirement": "Mô tả được sóng qua bước sóng, biên độ, tần số, tốc độ và cường độ sóng; vận dụng được biểu thức v = λf."
    },
    {
      "name": "Sóng – Sóng dọc và sóng ngang",
      "level": "qualitative",
      "requirement": "So sánh được sóng dọc và sóng ngang; đo được tần số của sóng âm bằng dao động kí."
    },
    {
      "name": "Sóng – Sóng điện từ",
      "level": "qualitative",
      "requirement": "Nêu được trong chân không mọi sóng điện từ truyền với cùng tốc độ; liệt kê được bậc độ lớn bước sóng trong thang sóng điện từ. (Kiểm được v = c.)"
    },
    {
      "name": "Sóng – Giao thoa sóng kết hợp",
      "level": "quantitative",
      "requirement": "Nêu được điều kiện quan sát hệ vân giao thoa; vận dụng được biểu thức i = λD/a cho giao thoa ánh sáng qua hai khe hẹp."
    },
    {
      "name": "Sóng – Sóng dừng",
      "level": "quantitative",
      "requirement": "Sử dụng các cách biểu diễn đại số và đồ thị để phân tích, xác định được vị trí nút và bụng của sóng dừng."
    },
    {
      "name": "Sóng – Đo tốc độ truyền âm",
      "level": "quantitative",
      "requirement": "Thiết kế và thực hiện phương án đo được tốc độ truyền âm bằng dụng cụ thực hành."
    },
    {
      "name": "Chuyên đề 11.2 – Biến điệu",
      "level": "qualitative",
      "requirement": "So sánh được biến điệu biên độ (AM) và biến điệu tần số (FM); liệt kê được tần số và bước sóng của các kênh truyền thông."
    },
    {
      "name": "Chuyên đề 11.2 – Tín hiệu tương tự và tín hiệu số",
      "level": "qualitative",
      "requirement": "Mô tả được ưu điểm của truyền dữ liệu dạng số; mô tả sơ lược chuyển đổi tương tự – số và số – tương tự."
    },
    {
      "name": "Chuyên đề 11.2 – Suy giảm tín hiệu",
      "level": "quantitative",
      "requirement": "Nêu được độ suy giảm tín hiệu tính theo dB và tính theo dB trên một đơn vị độ dài."
    }
  ],
  "roles": {
    "displacement": "li độ: độ dời của vật khỏi vị trí cân bằng trên một trục, tính bằng mét; con lắc đơn dùng li độ dài s = l·α (of, axis)",
    "amplitude": "biên độ dao động của vật hoặc của một phần tử môi trường (of)",
    "angular_frequency": "tần số góc ω: của dao động hay đại lượng xoay chiều hình sin của một vật, linh kiện (of), hoặc của sóng (in)",
    "frequency": "tần số: của dao động hay đại lượng xoay chiều của một vật, linh kiện (of); của sóng trong một môi trường (in); của một bức xạ (of = bức xạ đó)",
    "phase": "pha dao động ωt + φ của vật hoặc của một phần tử môi trường, với x = A·cos(pha) (of)",
    "initial_phase": "pha ban đầu φ của dao động (of)",
    "phase_difference": "độ lệch pha: của điện áp so với cường độ dòng điện của một đoạn mạch, dương khi điện áp sớm pha (of); hoặc giữa hai dao động — hai điểm trên phương truyền sóng, hai sóng tới cùng một điểm (of, in)",
    "max_speed": "tốc độ cực đại của vật dao động (of)",
    "max_acceleration": "độ lớn gia tốc cực đại của vật dao động (of)",
    "oscillation_energy": "cơ năng của dao động điều hoà với mốc thế năng ở vị trí cân bằng (of)",
    "pendulum_length": "chiều dài dây của con lắc đơn (of)",
    "wavelength": "bước sóng: của sóng trong một môi trường (in), hoặc của một bức xạ (of = bức xạ đó)",
    "wave_speed": "tốc độ truyền sóng (in; kind = electromagnetic cho sóng điện từ trong chân không hoặc không khí, electromagnetic_medium cho sóng điện từ trong môi trường khác); hoặc of = bức xạ khi mô hình mô tả từng bức xạ",
