  "assumptions": [
    "Khi năng lượng phôtôn không vượt công thoát (h*f ≤ A) không có electron bật ra: động năng cực đại, tốc độ và hiệu điện thế hãm bằng 0. Vị trí là quãng đường electron có động năng cực đại bay ra khỏi bề mặt trong chân không, không có điện trường."
  ],
  "equationSet": {
