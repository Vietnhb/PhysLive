  "assumptions": [
    "Quỹ đạo tròn đồng phẳng; tâm hệ (ví dụ Mặt Trời) cố định tại gốc. Góc pha là góc giữa hướng tâm→vật chính và hướng vật chính→vệ tinh: bằng 0 khi vệ tinh ở phía xa tâm (nhìn từ vật chính thấy sáng toàn bộ – trăng tròn), bằng 180° khi vệ tinh nằm giữa tâm và vật chính (trăng non). Hai góc ban đầu đo từ cùng một trục."
  ],
  "equationSet": {
    "canonical": [
      "vị trí = vị trí vật chính quanh tâm + vị trí vệ tinh quanh vật chính"
    ],
    "derived": [
      "pha Mặt Trăng: phần được chiếu sáng nhìn từ vật chính = (1 + cos(góc pha))/2",
      "nhật/nguyệt thực khi ba thiên thể thẳng hàng"
    ]
  },
