{
  "capabilityId": "vertical_spring_mass",
  "title": "Con lắc lò xo treo thẳng đứng",
  "version": "1.1",
  "applicability": {
    "objectTypes": [
      "body",
      "spring"
    ],
    "quantities": [
      "mass",
      "stiffness",
      "gravitational_acceleration",
      "initial_offset",
      "initial_velocity",
      "offset_from_natural_length"
    ]
  },
  "canonicalInputs": [
    {
      "key": "mass",
      "unit": "kg",
      "min": 1e-09
    },
    {
      "key": "stiffness",
      "unit": "N/m",
      "min": 1e-09
    },
    {
      "key": "gravitational_acceleration",
      "unit": "m/s^2",
      "min": 1e-06,
      "defaultValue": 9.80665
    },
    {
      "key": "initial_offset",
      "unit": "m",
      "defaultValue": 0,
      "description": "độ lệch ban đầu của vật, dương hướng lên; đo từ vị trí cân bằng, hoặc từ vị trí lò xo không biến dạng khi offset_from_natural_length = 1"
    },
    {
      "key": "initial_velocity",
      "unit": "m/s",
      "defaultValue": 0,
      "description": "vận tốc ban đầu, dương hướng lên"
    },
    {
      "key": "offset_from_natural_length",
      "unit": "1",
      "min": 0,
      "max": 1,
      "defaultValue": 0,
      "description": "0: độ lệch ban đầu đo từ vị trí cân bằng (kéo vật khỏi vị trí cân bằng rồi thả); 1: đo từ vị trí lò xo không biến dạng (giữ vật ở chỗ lò xo chưa dãn rồi thả thì độ lệch ban đầu = 0)"
    }
  ],
  "outputs": [
    {
      "key": "position",
      "unit": "m"
    },
    {
      "key": "velocity",
      "unit": "m/s"
    },
    {
      "key": "elongation",
      "unit": "m"
    },
    {
      "key": "force",
      "unit": "N"
    },
    {
      "key": "elastic_energy",
      "unit": "J"
    }
  ],
  "assumptions": [
    "Lò xo nhẹ treo thẳng đứng, đầu trên cố định, trong giới hạn đàn hồi. Tọa độ (position) có gốc tại vị trí lò xo không biến dạng, chiều dương hướng lên; vị trí cân bằng ở -m*g/k. Độ dãn (elongation) dương khi lò xo dãn."
  ],
  "equationSet": {
    "canonical": [
      "F_dh = k*|Delta l| (định luật Hooke)",
      "cân bằng: k*Delta l0 = m*g"
    ],
    "derived": [
      "Wt_dh = k*x^2/2"
    ]
  },
